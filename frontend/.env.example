# Veriqo Frontend Environment Configuration
# Copy this file to .env or .env.local to configure real external Supabase service.
# If omitted or left as demo defaults, Veriqo runs in standalone client-side mock/seed mode.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

